cmd Ref.cmdDisp.CMD_NO_OP []
cmd Ref.cmdDisp.CMD_NO_OP_STRING []
# alternatively:
cmd 0x58 0x01 0x48 0x60 0x50 0x51 # Ref.cmdDisp.CMD_NO_OP_STRING "asdf"

