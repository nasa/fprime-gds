input: (_NEWLINE | _toplevel_stmt)*

_toplevel_stmt: _cmd_stmt

_cmd_stmt: time_tag mnemonic (","? _value_list)?
_value_list: value (","? value)*

time_tag: RELATIVE_TIME | ABSOLUTE_TIME

mnemonic: NAME

value: _literal | object | array | NAME
array: "[" [value ("," value)* [","]] "]"
kv: NAME ":" value
object: "{" [kv ("," kv)* [","]] "}"

_literal: number | string | boolean
number: DEC_NUMBER | FLOAT_NUMBER | HEX_NUMBER
# -> AstNumber(value)
string: STRING
# -> AstString(value)
boolean: CONST_FALSE | CONST_TRUE
# -> AstBoolean(value)


_NEWLINE: ( /\r?\n[\t ]*/ | COMMENT )+

%ignore /[\t \f]+/
%ignore /\\[\t \f]*\r?\n/   // LINE_CONT
%ignore COMMENT

# Word boundary so that identifiers such as TRUE_STATE lex as NAME
CONST_TRUE.2: /(True|true|TRUE)\b/
CONST_FALSE.2: /(False|false|FALSE)\b/
NAME: /\$?[^\W\d]\w*(\.\w+)*/
COMMENT: /;[^\n]*/

STRING: /("(?!"").*?(?<!\\)(\\\\)*?"|'(?!'').*?(?<!\\)(\\\\)*?')/i

_SIGN: "+" | "-"

# -2 prio so we resolve after floats
DEC_NUMBER.-2:   _SIGN? "1".."9"        ("_"?  "0".."9"                       )*
             |   _SIGN? "0"             ("_"?  "0"                            )* /(?![1-9xX])/

# Hex integer literals (0x or 0X prefix)
HEX_NUMBER: _SIGN? ("0x" | "0X") ("_"? /[0-9a-fA-F]/)+

_SPECIAL_DEC: "0".."9"        ("_"?  "0".."9"                       )*

DECIMAL: "." _SPECIAL_DEC | _SPECIAL_DEC "." _SPECIAL_DEC?
_EXP: ("e"|"E") ["+" | "-"] _SPECIAL_DEC
# -1 prio so we resolve the .. syntax in for loop range first
FLOAT_NUMBER.-1: _SIGN? (_SPECIAL_DEC _EXP | DECIMAL _EXP?)

# Time format terminals
_TIME_COMPONENT: /\d{2}/
_MICROSECONDS: /\d{1,6}/
_YEAR: /\d{4}/
_DAY_OF_YEAR: /\d{3}/

_TIME_HMS: _TIME_COMPONENT ":" _TIME_COMPONENT ":" _TIME_COMPONENT ("." _MICROSECONDS)?
_ABS_DATETIME: _YEAR "-" _DAY_OF_YEAR "T" _TIME_HMS

# Time tags are single terminals (prio 1) so that a bare "R" or "A" elsewhere
# (e.g. an enum value) still lexes as NAME
RELATIVE_TIME.1: "R" _TIME_HMS
ABSOLUTE_TIME.1: "A" _ABS_DATETIME
